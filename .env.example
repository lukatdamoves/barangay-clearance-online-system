# =====================================================================
#  Barangay Clearance Online System — environment template
# =====================================================================
#  Copy to `.env` and fill in. `.env` is gitignored.
#
#  cp .env.example .env
#
#  WARNING: the values currently hardcoded in the source are LIVE
#  credentials that have been committed to a public repository.
#  Rotate the Gmail app password before using it again — see
#  docs/security-audit.md finding #1.
# =====================================================================

# ---- Database -------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=barangay_clearance

# ---- SMTP (Gmail) ---------------------------------------------------
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2FA enabled on the Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-app-password-here
MAIL_FROM_NAME=Barangay Clearance Online System

# ---- Application ----------------------------------------------------
# The account that gets admin access. Currently the code checks for
# user_id == 1 literally, so this is informational only.
ADMIN_USER_ID=1

# Upload constraints (not yet enforced by the code — see audit finding #3)
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png

# ---- Environment ----------------------------------------------------
# Set to `production` on a live server. Turns error display off.
APP_ENV=development
